{
  "manifest_version": 3,
  "name": "Agent Sticky Notes",
  "description": "Floating sticky notes panel for fast copy/paste templates across websites.",
  "version": "1.0.0",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Agent Sticky Notes",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
